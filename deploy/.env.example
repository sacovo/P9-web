# Copy to .env on the server and fill in. `deploy.sh` refuses to run while
# ENCRYPTION_KEY is still the placeholder.

# The zone every site below lives in. Must match `baseDomain` in
# ../site.config.json — deploy.sh checks that the two agree and stops if not.
BASE_DOMAIN=fhnw-rover.ch

# The zone this deployment used to live in. Every host under it is served as a
# permanent redirect to the same label under BASE_DOMAIN, so links shared before
# the move keep working. Withdraw the old DNS records first, then delete this
# and the matching Caddyfile block.
LEGACY_DOMAIN=fhnw-rover.sacovo.ch

# Subdomain labels. Must match `labels` in ../site.config.json.
SITE_LABEL=p9
N8N_LABEL=n8n-demo
TURTLE_LABEL=n8n-turtle
PREVIEW_LABEL=n8n-preview
RECAP_LABEL=recap-demo

# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=sandrocovo@gmail.com

# Encrypts n8n's stored credentials. Generate ONCE with `openssl rand -hex 24`
# and never change it, or n8n can no longer read the credentials it saved.
ENCRYPTION_KEY=change-me-openssl-rand-hex-24

TIMEZONE=Europe/Zurich

# Keep n8n execution history bounded so a demo running for months does not
# grow an unbounded database.
EXECUTIONS_MAX_AGE_HOURS=2

# Image for the canvas renderer. It must be the demo image, not stock n8n: a
# canvas can only draw a node whose type it knows, and stock n8n has never
# heard of @fhnw-rover/n8n-nodes-ros2 — every ROS node renders as "?" with
# "detailed node info is not available". Stock n8n does support
# N8N_PREVIEW_MODE (upstream since 2024); it just cannot draw these nodes.
N8N_PREVIEW_IMAGE=ghcr.io/sacovo/n8n-nodes-ros2:n8n-amd64

# Image for the rover demo's own n8n (used by that stack, not by the edge).
# Building n8n from source needs far more than the 2 vCPU and 3 GB this box
# has, so a prebuilt image is not optional here.
N8N_IMAGE=ghcr.io/sacovo/n8n:master
