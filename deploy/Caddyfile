{
	email {$ACME_EMAIL}
}

# ---------------------------------------------------------------------------
# The thesis site. Static files, rsynced into ./site by deploy.sh.
# ---------------------------------------------------------------------------
{$SITE_LABEL}.{$BASE_DOMAIN} {
	encode zstd gzip
	root * /srv/site
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	# Hashed assets are immutable; the PDF and images are not.
	@immutable path /_astro/* /smolvla-presentation/assets/* /defense/assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Both Slidev decks are single-page apps: /smolvla-presentation/7 and
	# /defense/7 are client routes, not files, so a reload or a shared deep
	# link must land on that deck's own index rather than the site 404 below.
	# Files that do exist under those prefixes are served first.
	# vercel.json and public/_redirects carry the same rules.
	#
	# The scope has to come from the `route` wrapper: try_files takes no
	# matcher of its own and reads one as one more candidate file name, which
	# quietly turns this into a site-wide fallback and swallows every 404. That
	# is also why each deck needs its own block rather than one shared matcher:
	# the fallback names one index.
	@deck path /smolvla-presentation/*
	route @deck {
		try_files {path} {path}/index.html /smolvla-presentation/index.html
	}

	@defense path /defense/*
	route @defense {
		try_files {path} {path}/index.html /defense/index.html
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

# ---------------------------------------------------------------------------
# n8n editor. n8n's own owner account is the authentication boundary.
#
# N8N_PREVIEW_MODE is deliberately NOT set on this instance: it would disable
# X-Frame-Options instance-wide and skip the owner-setup redirect, on the one
# instance that holds the credentials and can drive the robot.
# ---------------------------------------------------------------------------
{$N8N_LABEL}.{$BASE_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff

		# n8n sends no X-Frame-Options of its own here: NODE_ENV is unset in
		# that container, so it believes it is in development and helmet
		# disables the header. Without this the editor is framable by any
		# origin, which is clickjacking against a logged-in owner who has the
		# Code node. Setting it at the edge fixes that regardless of what the
		# app decides, and still admits the thesis site, which embeds the
		# public form and the agent chat from these same paths.
		#
		# n8n's own CSP on /form/* (a `sandbox` directive) is left alone —
		# two CSP headers are enforced independently, so both hold.
		Content-Security-Policy "frame-ancestors 'self' https://{$SITE_LABEL}.{$BASE_DOMAIN}"
	}

	reverse_proxy n8n:5678 {
		flush_interval -1
	}
}

# ---------------------------------------------------------------------------
# Read-only live view of the robot. No authentication on purpose: the VNC
# export runs with -viewonly, so visitors can watch but not drive.
# ---------------------------------------------------------------------------
{$TURTLE_LABEL}.{$BASE_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# frame-ancestors rather than X-Frame-Options: the thesis site embeds
		# this viewer cross-origin, and X-Frame-Options has no allow-list that
		# browsers still honour. Still deny-by-default for everyone else.
		Content-Security-Policy "frame-ancestors 'self' https://{$SITE_LABEL}.{$BASE_DOMAIN}"
	}

	# Live battery and state readout, served by the rover process itself so it
	# keeps working while n8n restarts. Read-only; it never writes.
	handle /api/* {
		reverse_proxy ros2:8081
	}

	handle {
		reverse_proxy ros2:6080
	}
}

# ---------------------------------------------------------------------------
# Workflow-canvas renderer for <n8n-demo>. A second n8n with no credentials,
# no imported workflows and a throwaway database: the workflow JSON is
# postMessaged in from the visitor's page, so it needs no data of its own.
# This is the instance that may run with N8N_PREVIEW_MODE=true.
# ---------------------------------------------------------------------------
{$PREVIEW_LABEL}.{$BASE_DOMAIN} {
	encode zstd gzip
	reverse_proxy n8n-preview:5678 {
		flush_interval -1
	}
}

# ---------------------------------------------------------------------------
# The PushT / RECAP demo. Static; model weights are fetched from the HF Hub at
# runtime and are never served from here.
# ---------------------------------------------------------------------------
{$RECAP_LABEL}.{$BASE_DOMAIN} {
	encode zstd gzip
	root * /srv/recap
	file_server

	header {
		X-Content-Type-Options nosniff
		# Embedded by the thesis site on /demos/pusht.
		Content-Security-Policy "frame-ancestors 'self' https://{$SITE_LABEL}.{$BASE_DOMAIN}"
	}

	handle_errors {
		rewrite * /index.html
		file_server
	}
}

# ---------------------------------------------------------------------------
# The zone this deployment used to live in. Every host under {$LEGACY_DOMAIN}
# answers with a permanent redirect to the same label under {$BASE_DOMAIN}, so
# links shared before the move keep working.
#
# All five old names still resolve to this box and their certificates are
# already in the caddy_data volume, so this block issues nothing new.
#
# {labels.3} is the leftmost label of a four-label name — p9.fhnw-rover.sacovo.ch
# is [ch, sacovo, fhnw-rover, p9] counting from the right — which is exactly the
# site label to carry across. One block therefore covers all five hosts. It is
# tied to LEGACY_DOMAIN having three labels; a different old zone needs the
# index adjusted to match.
#
# Retire this by withdrawing the old DNS records first, then deleting this
# block and LEGACY_DOMAIN from .env — in that order, so nothing 301s to a name
# that has stopped resolving.
# ---------------------------------------------------------------------------
{$SITE_LABEL}.{$LEGACY_DOMAIN},
{$N8N_LABEL}.{$LEGACY_DOMAIN},
{$TURTLE_LABEL}.{$LEGACY_DOMAIN},
{$PREVIEW_LABEL}.{$LEGACY_DOMAIN},
{$RECAP_LABEL}.{$LEGACY_DOMAIN} {
	redir https://{labels.3}.{$BASE_DOMAIN}{uri} permanent
}
