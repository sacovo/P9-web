---
import { overview } from '../lib/p9';
---

<section id="overview" class="shell scroll-mt-20 pt-20!">
  <div class="grid gap-x-[var(--spacing-pad)] gap-y-6 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="eyebrow">{overview.eyebrow}</p>
      <h3 class="max-w-[18ch]">{overview.heading}</h3>
    </div>
    <div class="lg:col-span-7 lg:col-start-6">
      {overview.body.map((para) => <p class="text-grey-4 last:mb-0">{para}</p>)}
    </div>
  </div>
</section>
