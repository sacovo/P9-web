---
import { hosts } from '../config';

/**
 * The live view, embedded.
 *
 * Two independent sources, on purpose:
 *
 *  - The picture is `embed.html`, a page the demo image ships purely for this:
 *    a canvas driven by noVNC's RFB module and nothing else. Neither of
 *    noVNC's own pages works here — both carry a toolbar or status bar, print
 *    the container id as the display hostname, and render in the browser's
 *    locale, so this page would show a German status line over the robot.
 *  - The numbers come from the rover process itself on /api/status, which is
 *    served beside n8n rather than through it — so the readout survives the
 *    hourly reset restarting n8n, and it sends `access-control-allow-origin: *`
 *    so this page can read it cross-origin.
 *
 * The viewer grants `frame-ancestors` to this origin specifically. If that
 * ever stops being true the frame silently shows nothing, so the script below
 * falls back to a link rather than leaving a blank rectangle.
 */
const canvas = hosts.turtle ? `${hosts.turtle}/embed.html` : null;

const tiles = [
  { id: 'state', label: 'State' },
  { id: 'battery', label: 'Battery' },
  { id: 'target', label: 'Destination' },
  { id: 'led', label: 'Status LED' },
  { id: 'pose', label: 'Position' },
  { id: 'uptime', label: 'Uptime' },
];
---

{
  canvas && (
    <section id="live" class="shell scroll-mt-20 pt-10!">
      <div class="grid gap-x-[var(--spacing-pad)] gap-y-6 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <div
            id="viewer-frame"
            class="bracket relative aspect-square w-full max-w-[640px] border border-grey-2 bg-grey-1"
          >
            <iframe
              id="viewer"
              src={canvas}
              title="Live view of the demo rover, read-only"
              class="absolute inset-0 h-full w-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer"
            />
          </div>

          <noscript>
            <p class="mt-3 text-[0.85rem] text-grey-3">
              The readout beside this needs JavaScript. The picture does not.
            </p>
          </noscript>

          <p class="mt-3 mb-0 max-w-[62ch] text-[0.8rem] leading-[165%] text-grey-3">
            Read-only at the protocol level, not by convention: <code>x11vnc</code> runs with
            <code>-viewonly</code>, so the server never applies pointer or keyboard events
            whatever a client sends. Rosbridge itself is bound to localhost and is not on the
            internet. <a href={hosts.turtle!} rel="noopener">Open the viewer on its own</a>.
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="flex items-baseline justify-between gap-3">
            <p class="eyebrow mb-0!">Telemetry</p>
            <p id="live-age" class="m-0 text-[0.72rem] tracking-[0.08em] text-grey-3 uppercase">
              connecting
            </p>
          </div>

          <dl class="mt-4 mb-0 grid grid-cols-2 gap-x-[var(--spacing-pad)] gap-y-4">
            {tiles.map((t) => (
              <div class="border-t border-grey-2 pt-2">
                <dt class="text-[0.72rem] tracking-[0.08em] text-grey-3 uppercase">{t.label}</dt>
                <dd id={`live-${t.id}`} class="readout m-0 mt-1 text-[1.05rem] leading-tight">
                  &mdash;
                </dd>
              </div>
            ))}
          </dl>

          <div class="mt-5 border-t border-grey-2 pt-3">
            <div class="h-2 w-full bg-grey-2" role="img" aria-label="Battery charge">
              <div id="live-battery-bar" class="h-full w-0 bg-ink transition-[width] duration-700" />
            </div>
            <p class="m-0 mt-2 text-[0.75rem] text-grey-3">
              The watchdog fires below 25 %: it turns the LED red, preempts whatever mission is
              running and sends the rover to the dock.
            </p>
          </div>
        </div>
      </div>
    </section>
  )
}

{
  canvas && (
    <script define:vars={{ statusUrl: `${hosts.turtle}/api/status`, viewerUrl: hosts.turtle }}>
      const el = (id) => document.getElementById(id);
      const age = el('live-age');

      const fmt = {
        state: (s) => (s.estopped ? 'E-STOP' : s.charging ? 'CHARGING' : s.state),
        battery: (s) => `${s.battery.toFixed(1)} %`,
        target: (s) => s.target || '—',
        led: (s) => (s.led_blink ? `${s.led}, blinking` : s.led),
        pose: (s) => (s.pose.x == null ? '—' : `${s.pose.x.toFixed(2)}, ${s.pose.y.toFixed(2)}`),
        uptime: (s) => {
          const t = Math.round(s.uptime_seconds);
          const h = Math.floor(t / 3600);
          const m = Math.floor((t % 3600) / 60);
          return h ? `${h} h ${m} m` : `${m} m ${t % 60} s`;
        },
      };

      let failures = 0;

      async function poll() {
        // Nothing is watching a hidden tab, and this is someone else's robot.
        if (document.hidden) return;
        try {
          const res = await fetch(statusUrl, { cache: 'no-store' });
          if (!res.ok) throw new Error(String(res.status));
          const s = await res.json();

          for (const [id, f] of Object.entries(fmt)) el(`live-${id}`).textContent = f(s);

          const bar = el('live-battery-bar');
          bar.style.width = `${Math.max(0, Math.min(100, s.battery))}%`;
          // The one place colour carries meaning: below the watchdog threshold.
          bar.style.background =
            s.battery <= s.low_battery_threshold ? 'var(--color-yellow)' : 'var(--color-ink)';

          failures = 0;
          age.textContent = 'live';
        } catch {
          failures += 1;
          // One miss is a dropped packet, not an outage; say so only if it sticks.
          if (failures > 2) age.textContent = 'reconnecting';
        }
      }

      poll();
      setInterval(poll, 2000);
      document.addEventListener('visibilitychange', () => !document.hidden && poll());

      // A blocked frame renders nothing and fires no error, so treat "still
      // blank well after load" as blocked and offer the link instead.
      setTimeout(() => {
        const frame = document.getElementById('viewer-frame');
        const iframe = document.getElementById('viewer');
        let painted = false;
        try {
          painted = Boolean(iframe.contentWindow && iframe.contentWindow.length >= 0);
        } catch {
          painted = true; // cross-origin access throwing means it did load
        }
        if (!painted) {
          frame.innerHTML =
            '<div class="flex h-full items-center justify-center p-6 text-center">' +
            '<p class="m-0 text-[0.9rem]">The live view could not be embedded here. ' +
            `<a href="${viewerUrl}" rel="noopener">Open it directly</a>.</p></div>`;
        }
      }, 8000);
    </script>
  )
}
