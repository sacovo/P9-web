---
import galleryData from '../../content/gallery.json';
import WorkflowCanvas from './WorkflowCanvas.astro';
import { workflowCanvasSrc } from '../config';

/**
 * The five workflows off the machine that drives the PHYSICAL rover.
 *
 * Deliberately a separate section from <WorkflowGallery>, which shows the
 * eleven teaching workflows built against the simulated rover. These are the
 * opposite end of the same idea: not written to demonstrate a node, but to get
 * a job done, and consequently full of retries, sub-workflow calls and hardware
 * that only exists on the real robot — a drill, a load cell, a tool changer, a
 * manipulator. Reading them next to the eleven is the point.
 *
 * They are shown, never run. The demo's own setup never imports this set into
 * n8n either: they ship active, and their triggers would fire against
 * interfaces that are not there.
 *
 * Sourced by `node scripts/import-gallery.mjs`, which takes the REDACTED copy
 * the demo publishes rather than the verbatim exports — see that script.
 */
const { workflows } = galleryData;
const src = workflowCanvasSrc();

/** Bucket label → the chip prefix that makes a bare ROS name legible. */
const KINDS = [
  ['services', 'srv'],
  ['topics', 'top'],
  ['actions', 'act'],
] as const;

/**
 * Deep Sampling touches 17 interfaces, and these are long names — a full list
 * makes the metadata rail several times taller than the canvas beside it. Show
 * a representative set and say how many were left, rather than quietly cutting
 * the tail off and implying the workflow only touches eight things.
 */
const CHIP_LIMIT = 8;
---

<section id="rover-workflows" class="shell scroll-mt-20 pt-16!">
  <p class="eyebrow">From the real rover</p>
  <h3 class="rule mb-3">Five workflows doing an actual job</h3>
  <p class="mb-10 max-w-[72ch] text-grey-4">
    The eleven above were written to show what a node does. These five came off the n8n instance
    that drives the physical rover, and were written to get work done — swapping an end effector,
    running a sampling campaign, walking a maintenance checklist. They are longer, they retry, and
    they call each other. Shown here read-only: identifiers have been pseudonymised, and the
    hardware they name is not on the simulated rover.
  </p>

  <div class="grid gap-12">
    {
      workflows.map((w) => (
        <article data-reveal>
          <h4 class="text-[1.05rem] leading-[140%]">{w.title}</h4>
          {w.subtitle && <p class="mt-1 mb-0 text-[0.9rem] text-grey-4">{w.subtitle}</p>}

          {/* The blurb carries <code> spans for the ROS names it mentions. */}
          <p class="mt-3 mb-5 max-w-[72ch] text-[0.9rem] leading-[170%] text-grey-4" set:html={w.blurb} />

          <div class="grid gap-x-[var(--spacing-pad)] gap-y-3 lg:grid-cols-12">
            <div class="lg:col-span-3">
              <p class="m-0 text-[0.72rem] tracking-[0.06em] text-grey-3 uppercase">
                {w.nodeCount} nodes · {w.rosCount} ROS
              </p>

              {w.highlights.length > 0 && (
                <ul class="mt-3 mb-0 list-none p-0 text-[0.82rem] leading-[160%] text-grey-4">
                  {w.highlights.map((h) => (
                    <li class="mb-2 border-l-2 border-yellow pl-3">{h}</li>
                  ))}
                </ul>
              )}

              {/* The ROS surface each one touches, which is the part that ties
                  these back to the node package the thesis is about. */}
              {KINDS.map(([bucket, label]) => {
                const all = w.interfaces[bucket] ?? [];
                if (all.length === 0) return null;
                const shown = all.slice(0, CHIP_LIMIT);
                const hidden = all.length - shown.length;
                return (
                  <ul class="mt-3 mb-0 flex list-none flex-wrap gap-1 p-0">
                    {shown.map((name) => (
                      <li class="border border-grey-2 px-1.5 py-0.5 font-mono text-[0.7rem] text-grey-4">
                        <span class="text-grey-3">{label}</span> {name}
                      </li>
                    ))}
                    {hidden > 0 && (
                      <li class="px-1.5 py-0.5 font-mono text-[0.7rem] text-grey-3">
                        +{hidden} more
                      </li>
                    )}
                  </ul>
                );
              })}

              {w.phases.length > 0 && (
                <p class="mt-3 mb-0 text-[0.78rem] leading-[160%] text-grey-3">
                  {w.phases.join(' · ')}
                </p>
              )}
            </div>

            <div class="min-w-0 lg:col-span-9">
              <WorkflowCanvas workflow={w.workflow} src={src} />
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
