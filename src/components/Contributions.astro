---
import { contributions, supporting } from '../lib/p9';
---

<section id="contributions" class="shell scroll-mt-20 pt-20!">
  <h3 class="rule mb-8">Contributions</h3>

  <ol class="m-0 grid list-none gap-[var(--spacing-pad)] p-0 md:grid-cols-2 lg:grid-cols-3">
    {
      contributions.map((c) => (
        <li class="hoverable flex flex-col border! border-grey-2! bg-paper p-5" data-reveal>
          <p class="readout eyebrow mb-2! text-ink!">{c.n}</p>
          <h4 class="text-[1.05rem] leading-[140%]">{c.title}</h4>
          <p class="mt-2 mb-4 text-[0.95rem] text-grey-4">{c.body}</p>

          <div class="mt-auto border-t border-grey-2 pt-3">
            <p class="readout m-0 text-[1.6rem] leading-none">{c.metric.value}</p>
            <p class="m-0 mt-1 text-[0.85rem] font-medium">{c.metric.label}</p>
            <p class="m-0 mt-1 text-[0.78rem] leading-[150%] text-grey-3">{c.metric.note}</p>
          </div>

          <p class="m-0 mt-3 text-[0.72rem] tracking-[0.08em] text-grey-3 uppercase">
            {c.question}
          </p>
        </li>
      ))
    }
  </ol>

  <div class="mt-12 border-t border-grey-2 pt-8">
    <div class="grid gap-x-[var(--spacing-pad)] gap-y-4 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow">{supporting.eyebrow}</p>
        <h4 class="max-w-[22ch] text-[1.05rem]">{supporting.heading}</h4>
        <p class="mt-3 mb-0 text-[0.78rem] leading-[160%] text-grey-3">{supporting.note}</p>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        {supporting.body.map((para) => <p class="text-[0.95rem] text-grey-4 last:mb-0">{para}</p>)}
      </div>
    </div>
  </div>
</section>
