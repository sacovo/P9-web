---
import { figures } from '../lib/p9';
import { report } from '../config';

/**
 * The dialog below is the styleguide's own `.materialboxed` lightbox,
 * reimplemented: click to enlarge, click anywhere or press Escape to dismiss.
 * Its shipped main.js is not imported — this is a dozen lines and no jQuery.
 */
---

<section id="figures" class="shell scroll-mt-20 pt-20!">
  <p class="eyebrow">{figures.eyebrow}</p>
  <h3 class="rule mb-3">{figures.heading}</h3>
  <p class="mb-8 max-w-[65ch] text-grey-4">
    {figures.note}
    {
      report.pdf && (
        <>
          {' '}
          <a href={report.pdf}>Download the report</a>.
        </>
      )
    }
  </p>

  <div class="grid gap-[var(--spacing-pad)] md:grid-cols-2 lg:grid-cols-3">
    {
      figures.items.map((f) => (
        <figure
          class:list={['m-0 flex flex-col', f.wide && 'md:col-span-2 lg:col-span-3']}
          data-reveal
        >
          <button type="button" class="materialboxed hoverable block cursor-zoom-in border-0 bg-grey-1 p-0" data-full={f.src} data-caption={f.caption}>
            <img
              src={f.src}
              alt={f.alt}
              loading="lazy"
              decoding="async"
              class="responsive block w-full"
            />
          </button>
          <figcaption class="mt-2 text-[0.82rem] leading-[165%] text-grey-3">
            {f.caption}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<dialog
  id="lightbox"
  class="max-h-none max-w-none border-0 bg-transparent p-0 backdrop:bg-[#292929]/95"
  aria-label="Enlarged figure"
>
  <div class="flex h-screen w-screen cursor-zoom-out flex-col items-center justify-center gap-4 p-6">
    <img id="lightbox-img" src="" alt="" class="max-h-[80vh] max-w-full object-contain" />
    <p id="lightbox-caption" class="m-0 max-w-[80ch] text-center text-[0.85rem] leading-[165%] text-grey-2"></p>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const caption = document.getElementById('lightbox-caption');

  if (dialog && img && caption) {
    document.querySelectorAll<HTMLButtonElement>('.materialboxed').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const source = trigger.querySelector('img');
        img.src = trigger.dataset.full ?? '';
        img.alt = source?.alt ?? '';
        caption.textContent = trigger.dataset.caption ?? '';
        dialog.showModal();
      });
    });

    // Escape is handled by <dialog> itself; this covers click-to-dismiss.
    dialog.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      img.src = '';
    });
  }
</script>
