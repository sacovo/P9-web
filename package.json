    "export:deck": "npm run export --workspace smolvla-presentation",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@n8n_io/n8n-demo-component": "^1.0.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "tailwindcss": "^4.3.3"
  }
}
