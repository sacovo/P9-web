{
  "name": "p9-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Companion site for the FHNW master's thesis P9 — Mars Rover Autonomy",
  "workspaces": [
    "presentation"
  ],
  "scripts": {
    "dev": "astro dev",
    "dev:deck": "npm run dev --workspace smolvla-presentation",
